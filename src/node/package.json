{
  "name": "@dendev/grunt",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client library for the Halo Infinite API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "halo",
    "halo-infinite",
    "xbox",
    "api",
    "typescript",
    "343-industries"
  ],
  "author": "Den Delimarsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dend/grunt",
    "directory": "src/node"
  },
  "homepage": "https://gruntapi.com",
  "bugs": {
    "url": "https://github.com/dend/grunt/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "lru-cache": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
